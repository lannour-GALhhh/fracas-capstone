# Copy to .env on the VM. Replace <VM_IP> with the Azure public IP.
POSTGRES_DB=fracas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DB_NAME=fracas_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=<VM_IP>
CORS_ALLOWED_ORIGINS=http://<VM_IP>
CSRF_TRUSTED_ORIGINS=http://<VM_IP>
FRONTEND_URL=http://<VM_IP>
VITE_API_URL=http://<VM_IP>

# Plain HTTP on an IP: no TLS, so disable HTTPS redirect + Secure cookies.
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
SECURE_HSTS_SECONDS=0

CRON_SECRET=CHANGE_ME
LOG_LEVEL=INFO
THROTTLE_USER=2000/hour
THROTTLE_ANON=200/hour
SMS_PROVIDER=console
PUSH_PROVIDER=console
MEDIA_STORAGE=local

FRACAS_ADMIN_USERNAME=admin
FRACAS_ADMIN_PASSWORD=CHANGE_ME
FRACAS_ADMIN_EMAIL=you@example.com
